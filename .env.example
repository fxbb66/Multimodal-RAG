# 复制本文件为 .env 并填入真实密钥。.env 不会被提交到版本库。

# AGICTO 统一平台（所有模型走此平台）
AGICTO_BASE_URL=https://api.agicto.cn/v1

# AGICTO 各模型独立 Key（每个模型单独创建 API）
RERANK_API_KEY=sk-你的rerank密钥
EMBEDDING_API_KEY=sk-你的embedding密钥
GEN_API_KEY=sk-你的生成密钥
REWRITE_API_KEY=sk-你的改写密钥
VL_API_KEY=sk-你的图片描述密钥

# DashScope（可选，仅用于 rerank 降级兜底）
DASHSCOPE_API_KEY=sk-你的百炼密钥
# 百炼 qwen3-vl-rerank 多模态重排专用 Key（可选，预留存档，当前代码未接入）
# VL_RERANK_API_KEY=sk-你的百炼vl-rerank密钥

# ---- 以下为可选覆盖项，留空即使用默认值 ----
# EMBEDDING_MODEL=tongyi-embedding-vision-plus
# DISNEY_GEN_MODEL=qwen3.7-plus
# 前端可切换回答生成平台到百炼（OpenAI 兼容端点）；百炼侧模型名 qwen-plus（对应 AGICTO 的 qwen3.7-plus）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_GEN_MODEL=qwen-plus
# REWRITE_MODEL=qwen3.8-flash
# VL_CAPTION_MODEL=qwen3.5-omni-flash
# rerank 降级链（逗号分隔，按优先级从高到低；默认首选 AGICTO qwen3-rerank，
# AGICTO 不可用时百炼兜底。rerank-v3.5 仅 AGICTO 可用且需 Cohere 账户有效）
# RERANK_MODELS=qwen3-rerank
# RERANK_TOPN=12
# MAX_PER_SOURCE=3
# USE_MMR=1
# MMR_LAMBDA=0.72
# MEDIA_SIM_THRESHOLD=0.45
# MEDIA_GAP=0.02
# SESSION_MAX=200
# SESSION_TTL=7200
# EMBED_CACHE_SIZE=256
# RATE_LIMIT_PER_MIN=30
# ---- 意图识别（R3 v2，use_rewrite=1 时生效） ----
# INTENT_ENABLED=1
# INTENT_CONFIDENCE_MIN=0.6
# INTENT_MAX_CLARIFY=2
# INTENT_MAX_SUB_QUERIES=4
