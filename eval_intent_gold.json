      "gold_multi": "是否预期多意图拆分（queries>=2）",
      "must_include": "retrieve 样例改写后子问题中必须全部保留的事实词（子串匹配），用于度量指代消解/补全质量",
      "history": "对话历史，role ∈ user/assistant；缺省为无历史"
    },
    "type_enums": ["clear", "underspecified", "context_dependent", "pronoun", "comparison", "multi_intent", "rhetorical"]
  },
